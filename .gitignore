# This repository holds the tool, never the data it visualises.
# Datasets are loaded at runtime through the import UI.

# --- data (yours or anyone else's) ---
*.csv
evaluation/
check/
target/
task.txt
dataset.json

# --- personal scripts + scratch that depend on a specific dataset ---
local/

# --- build output and dependencies ---
dist/
node_modules/

# --- editor / OS noise ---
.DS_Store
*.swp

# Generated by tools/make-fixture.mjs on every `npm test`. Synthetic, but still
# build output, so it is not tracked either.
test/fixtures/

# personal Claude Code settings
.claude/settings.local.json
.claude/worktrees/

# dev shim written by tools/make-fixture.mjs
src/dev-dataset.js
